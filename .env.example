# Comma-separated relay URLs. Use wss:// in live mode.
NOSTR_RELAYS=wss://nos.lol,wss://nostr.mom,wss://relay.primal.net
# Local-only setup page. The server always binds to 127.0.0.1.
NOSTR_SETUP_PORT=34846
# Session and signer request limits, in milliseconds.
NOSTR_SESSION_TTL_MS=1800000
# Hosted bridge (accountless capability sessions; put behind production HTTPS)
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
HOSTED_SESSION_TTL_MS=900000
HOSTED_MAX_SESSIONS=100
NOSTR_REQUEST_TIMEOUT_MS=120000
